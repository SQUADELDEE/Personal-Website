---
import type { MinecraftMod } from '../data/mods';
import { withBase } from '../lib/url';

interface Props {
  mod: MinecraftMod;
}

const { mod } = Astro.props;
---

<a
  href={mod.curseforgeUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="group block overflow-hidden rounded-lg border border-slate-800 bg-slate-900 transition-colors hover:border-slate-600"
>
  {mod.cover ? (
    <div class:list={['aspect-video w-full', mod.coverFit === 'contain' && 'flex items-center justify-center bg-slate-950 p-6']}>
      <img
        src={withBase(mod.cover)}
        alt={`${mod.title} cover art`}
        class={mod.coverFit === 'contain' ? 'max-h-full max-w-full object-contain' : 'h-full w-full object-cover'}
        loading="lazy"
      />
    </div>
  ) : (
    <div class="flex aspect-video w-full items-center justify-center bg-slate-800 font-mono text-sm text-slate-500">
      CurseForge
    </div>
  )}
  <div class="p-4">
    <h3 class="font-semibold text-slate-100 group-hover:text-white">{mod.title}</h3>
    <p class="mt-1 text-sm text-slate-400">{mod.description}</p>
    <span class="mt-2 inline-block text-sm text-orange-400 group-hover:text-orange-300">View on CurseForge →</span>
  </div>
</a>
