---
const links = [
  { href: '#games', label: 'Games' },
  { href: '#software', label: 'Software' },
  { href: '#assembiota', label: 'Assembiota' },
  { href: '#mods', label: 'Minecraft Mods' },
];
---

<header class="sticky top-0 z-10 border-b border-slate-800 bg-slate-950/80 backdrop-blur">
  <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href="#top" class="font-name text-lg text-slate-100">Jacob Grandchamps</a>
    <ul class="flex gap-6 text-sm text-slate-300">
      {links.map((link) => (
        <li>
          <a href={link.href} class="transition-colors hover:text-white">{link.label}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>
