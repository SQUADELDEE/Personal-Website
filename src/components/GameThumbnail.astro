---
import type { GodotGame } from '../data/games';
import { withBase } from '../lib/url';

interface Props {
  game: GodotGame;
}

const { game } = Astro.props;
---

<div class="flex w-full max-w-64 flex-col overflow-hidden rounded-lg border border-slate-800 bg-slate-900">
  <a
    href={game.playUrl}
    target="_blank"
    rel="noopener noreferrer"
    aria-label={`Play ${game.title} in a new tab`}
    class="group relative flex aspect-[4/3] w-full items-center justify-center bg-gradient-to-br from-slate-100 to-slate-300 p-4"
  >
    <img
      src={withBase(game.thumbnail)}
      alt={`${game.title} thumbnail`}
      class="max-h-full max-w-full object-contain transition-transform duration-300 group-hover:scale-105"
      loading="lazy"
    />
    <span class="absolute inset-0 flex items-center justify-center bg-slate-950/0 transition-colors group-hover:bg-slate-950/40">
      <span
        class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-950/70 text-white opacity-80 shadow-lg ring-1 ring-white/20 transition group-hover:scale-110 group-hover:opacity-100"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="ml-0.5 h-5 w-5">
          <path d="M8 5v14l11-7z" />
        </svg>
      </span>
    </span>
  </a>
  <div class="flex flex-1 flex-col p-3">
    <h3 class="text-sm font-semibold text-slate-100">{game.title}</h3>
    <p class="mt-1 text-xs text-slate-400">{game.description}</p>
    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs">
      <a href={game.playUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-orange-400 hover:text-orange-300">
        Play in browser →
      </a>
      {game.repoUrl && (
        <a href={game.repoUrl} target="_blank" rel="noopener noreferrer" class="text-sky-400 hover:text-sky-300">
          View source →
        </a>
      )}
    </div>
  </div>
</div>
