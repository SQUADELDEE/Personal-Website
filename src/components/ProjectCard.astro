---
import type { SoftwareProject } from '../data/projects';
import { withBase } from '../lib/url';

interface Props {
  project: SoftwareProject;
}

const { project } = Astro.props;
---

<a
  href={project.repoUrl}
  target="_blank"
  rel="noopener noreferrer"
  class="group block overflow-hidden rounded-lg border border-slate-800 bg-slate-900 transition-colors hover:border-slate-600"
>
  <div class:list={['aspect-video w-full', project.mediaFit === 'contain' && 'flex items-center justify-center bg-slate-950 p-6']}>
    <img
      src={withBase(project.media)}
      alt={`${project.title} demo`}
      class={project.mediaFit === 'contain' ? 'max-h-full max-w-full object-contain' : 'h-full w-full object-cover'}
      loading="lazy"
    />
  </div>
  <div class="p-4">
    <h3 class="font-semibold text-slate-100 group-hover:text-white">{project.title}</h3>
    <p class="mt-1 text-sm text-slate-400">{project.description}</p>
    <ul class="mt-3 flex flex-wrap gap-2">
      {project.tags.map((tag) => (
        <li class="rounded-full bg-slate-800 px-2 py-0.5 text-xs text-slate-300">{tag}</li>
      ))}
    </ul>
  </div>
</a>
