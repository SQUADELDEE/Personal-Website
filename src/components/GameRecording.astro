---
import type { GameRecording } from '../data/games';
import { withBase } from '../lib/url';

interface Props {
  recording: GameRecording;
}

const { recording } = Astro.props;
const isPhone = recording.frame === 'phone';
---

<div class={isPhone ? 'lg:sticky lg:top-24' : ''}>
  <div
    class:list={[
      'overflow-hidden bg-black shadow-lg shadow-black/40',
      isPhone
        ? 'mx-auto w-full max-w-[280px] rounded-[2rem] border-4 border-slate-800'
        : 'w-full rounded-lg border border-slate-800',
    ]}
  >
    <video
      src={withBase(recording.videoSrc)}
      autoplay
      muted
      loop
      playsinline
      class="w-full object-cover"
      style={`aspect-ratio: ${recording.aspectRatio};`}
    />
  </div>
  <div class:list={['mt-4', isPhone ? 'mx-auto max-w-[280px] text-center' : 'text-center']}>
    <h3 class="font-semibold text-slate-100">{recording.title}</h3>
    <p class="mt-1 text-sm text-slate-400">{recording.description}</p>
    {recording.repoUrl && (
      <a href={recording.repoUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm text-sky-400 hover:text-sky-300">
        View source →
      </a>
    )}
  </div>
</div>
