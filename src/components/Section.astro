---
interface Props {
  id: string;
  title: string;
  description?: string;
}

const { id, title, description } = Astro.props;
---

<section id={id} class="mx-auto max-w-7xl px-6 py-16">
  <h2 class="text-2xl font-semibold text-slate-100">{title}</h2>
  {description && <p class="mt-2 max-w-2xl text-slate-400">{description}</p>}
  <div class="mt-8">
    <slot />
  </div>
</section>
